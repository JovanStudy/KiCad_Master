(symbol "OCTAVE_SWITCH_MOOG"
  (in_bom yes)
  (on_board yes)

  (property "Reference" "SW" (at 0 6 0))
  (property "Value" "OCTAVE_MOOG_4P3T" (at 0 -6 0))

  ; pins (4 poles, 3 positions)
  (pin passive line (at -10 4 0) (length 3) (name "A") (number "1"))
  (pin passive line (at -10 2 0) (length 3) (name "B") (number "2"))
  (pin passive line (at -10 0 0) (length 3) (name "C") (number "3"))
  (pin passive line (at -10 -2 0) (length 3) (name "D") (number "4"))

  (pin passive line (at 10 4 180) (length 3) (name "16'") (number "5"))
  (pin passive line (at 10 2 180) (length 3) (name "8'")  (number "6"))
  (pin passive line (at 10 0 180) (length 3) (name "4'")  (number "7"))

  ; Moog-style drawing (circle rotor)
  (arc (start -2 6) (mid 0 8) (end 2 6))
  (arc (start 2 6) (mid 0 4) (end -2 6))
)